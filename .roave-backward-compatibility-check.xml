<?xml version="1.0" encoding="UTF-8" ?>
<roave-bc-check
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/roave/backward-compatibility-check/Resources/schema.xsd">
    <baseline>
        <!-- Methods inherited from Symfony parent classes that Symfony 8 removed: they depend on the Symfony version installed by the user, not on this plugin. -->
        <ignored-regex>#\[BC\] REMOVED: Method (Symfony\\Component\\\S+|\S+ \(inherited from Symfony\\Component\\\S+\)) was removed#</ignored-regex>
    </baseline>
</roave-bc-check>
